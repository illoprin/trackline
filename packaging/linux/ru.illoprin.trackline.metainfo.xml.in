<?xml version="1.0" encoding="UTF-8"?>
<!-- AppStream metadata (software centres, Flathub). Template: package.sh and the Flatpak
     manifest substitute @VERSION@ and @DATE@ from Cargo.toml and the build date.
     Trackline is an independent fork of FilmCraft (storytold/filmcraft); it is not an official
     FilmCraft or ArtCraft product. -->
<component type="desktop-application">
  <id>ru.illoprin.trackline</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT OR Apache-2.0</project_license>
  <name>Trackline</name>
  <summary>Non-linear video editor and all-in-one toolkit for social media</summary>
  <developer id="ru.illoprin">
    <name>Trackline maintainers</name>
  </developer>
  <description>
    <p>
      Trackline is a non-linear video editor and all-in-one toolkit for social media, built on the
      open-source FilmCraft engine. It is an independent fork of FilmCraft and is not an official
      FilmCraft or ArtCraft product.
    </p>
  </description>
  <launchable type="desktop-id">ru.illoprin.trackline.desktop</launchable>
  <icon type="stock">ru.illoprin.trackline</icon>
  <!-- Only url types known to appstream 0.15 (Ubuntu 22.04, where CI validates): no vcs-browser. -->
  <url type="homepage">https://github.com/storytold/filmcraft</url>
  <url type="bugtracker">https://github.com/storytold/filmcraft/issues</url>
  <url type="help">https://github.com/storytold/filmcraft/tree/main/docs</url>
  <categories>
    <category>AudioVideo</category>
    <category>Video</category>
    <category>AudioVideoEditing</category>
  </categories>
  <keywords>
    <keyword>video</keyword>
    <keyword>video editor</keyword>
    <keyword>timeline</keyword>
    <keyword>color grading</keyword>
    <keyword>nle</keyword>
  </keywords>
  <screenshots>
    <screenshot type="default">
      <caption>Color workspace: a documentary cut with Color Grading, scopes, captions and loudness meters</caption>
      <image>https://raw.githubusercontent.com/storytold/filmcraft/main/docs/images/filmcraft-hero.png</image>
    </screenshot>
  </screenshots>
  <branding>
    <color type="primary" scheme_preference="light">#9fd0ff</color>
    <color type="primary" scheme_preference="dark">#1f64ba</color>
  </branding>
  <requires>
    <display_length compare="ge">760</display_length>
  </requires>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
    <control>tablet</control>
  </supports>
  <provides>
    <binary>filmcraft</binary>
    <mediatype>application/x-filmcraft</mediatype>
  </provides>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="@VERSION@" date="@DATE@"/>
  </releases>
</component>
